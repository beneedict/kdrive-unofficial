 ExitCode AbstractUpdater::checkUpdateAvailable(const DistributionChannel currentChannel, UniqueId *id /*= nullptr*/) {
+#if defined(KD_LINUX)
+    // Fedora package: updates are delivered by the package manager (dnf),
+    // so the Infomaniak update endpoint is never contacted and no AppImage
+    // download is offered.
+    (void) currentChannel;
+    (void) id;
+    setState(UpdateState::UpToDate);
+    return ExitCode::Ok;
+#else
     setState(UpdateState::Checking);
     return _versionRetriever->retrieveVersion(currentChannel, id);
+#endif
 }
 
